# Copy to .env and adjust. Local development only — never commit .env.
POSTGRES_DB=optiroute
POSTGRES_USER=optiroute
POSTGRES_PASSWORD=optiroute
OPTI_PG_PORT=15432
OPTI_REDIS_PORT=16379
OPTI_OSRM_PORT=15000
OSRM_REGION=odisha
OSRM_MEM_LIMIT=2g

DATABASE_URL=postgres://optiroute:optiroute@localhost:15432/optiroute?sslmode=disable
REDIS_URL=redis://localhost:16379/0
OSRM_URL=http://localhost:15000

# Go API (dev only; generate a real secret with: openssl rand -base64 48)
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
API_ADDR=:8080
